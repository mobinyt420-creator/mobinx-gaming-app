rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ====================================================================
    // MOBIN X SUPER APP & ADMIN PANEL FIRESTORE RULES
    // Full bidirectional real-time sync for admin web console & mobile apps
    // ====================================================================

    // 1. App Configuration & Live Toggles (Auth Settings, Dynamic URLs, Notices, Updates)
    match /config/{configId} {
      allow read, write: if true;
    }
    
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // 2. Push Notifications & Real-Time Broadcasts
    match /notifications/{notifId} {
      allow read, write: if true;
    }

    // 3. FCM Device Registration Tokens
    match /fcm_tokens/{tokenId} {
      allow read, write: if true;
    }

    // 4. Banners, Flash Deals, Services & Shop Products
    match /banners/{bannerId} {
      allow read, write: if true;
    }
    
    match /flashDeals/{dealId} {
      allow read, write: if true;
    }

    match /downloads/{downloadId} {
      allow read, write: if true;
    }
    
    match /services/{serviceId} {
      allow read, write: if true;
    }

    match /shop_products/{productId} {
      allow read, write: if true;
    }

    // 5. Tournaments & Participants
    match /tournaments/{tournamentId} {
      allow read, write: if true;

      match /participants/{participantId} {
        allow read, write: if true;
      }
    }

    // 6. User Profiles & Directory
    match /users/{userId} {
      allow read, write: if true;
    }

    // 7. Top-up Requests & Orders
    match /topup_requests/{requestId} {
      allow read, write: if true;
    }

    // 8. Stats & Compliance Requests
    match /stats/{statId} {
      allow read, write: if true;
    }

    match /deletionRequests/{requestId} {
      allow read, write: if true;
    }

    // 9. Default Fallback
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
